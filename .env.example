# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: model id. Default is the fastest GA model; gemini-3.6-flash writes richer copy but is slower.
GEMINI_MODEL=gemini-3.5-flash-lite

# Required in production: Supabase project URL + service_role key (server only, never exposed to the browser).
# Leave empty locally to use .data/db.json instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: canonical public URL used in share links, e.g. https://creatorlaunch.vercel.app
PUBLIC_BASE_URL=

# Optional: per-attempt AI timeout in ms (default 25000)
LLM_TIMEOUT_MS=
