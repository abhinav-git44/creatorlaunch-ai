{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/edit/:id", "destination": "/edit" },
    { "source": "/s/:slug", "destination": "/api/page?slug=:slug" },
    { "source": "/api/stores/:id/publish", "destination": "/api/publish?id=:id" },
    { "source": "/api/stores/:id", "destination": "/api/store?id=:id" }
  ],
  "functions": {
    "api/generate.js": { "maxDuration": 60 },
    "api/regenerate.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "x-content-type-options", "value": "nosniff" },
        { "key": "referrer-policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
